{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ghostwriter-reading",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-11",
  "workers_dev": true,
  "observability": { "enabled": false },
  "vars": { "ALLOWED_ORIGIN": "https://nazarsecrets.github.io" },
  "ai": { "binding": "AI" },
  "ratelimits": [{ "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } }]
}
